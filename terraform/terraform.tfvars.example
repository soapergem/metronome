# Copy to terraform.tfvars and adjust. Never put the Cloudflare token here —
# the provider reads it from the CLOUDFLARE_API_TOKEN environment variable.

# domain_name          = "metronome.gemovationlabs.com"
# cloudflare_zone_name = "gemovationlabs.com"
# aws_region           = "us-east-1"
# price_class          = "PriceClass_100"

# Resource naming: the origin bucket becomes "<namespace>-<stage>-<name>-origin".
# namespace = "gemlabs"
# stage     = "prod"
# name      = "metronome"

# cloudfront_access_logging_enabled = false

# tags = {
#   Project = "metronome"
# }
